msgstr "&Kopyala"

msgid "&Copy file or folder…"
msgstr "Dosyayı veya klasörü &kopyala…"

msgid "&Destination file path:"
msgstr "&Hedef dosya yolu:"

msgid "&Destination folder path:"
msgstr "&Hedef klasör yolu:"

msgid "Cannot copy a folder into itself or its subfolder."
msgstr "Bir klasör kendi içine veya alt klasörüne kopyalanamaz."

msgid "Copy %s"
msgstr "%s dosyasını kopyala"

msgid "Copy %s to %s"
msgstr "%s dosyasını %s konumuna kopyala"

msgid "Copy File — %s"
msgstr "Dosyayı Kopyala — %s"

msgid "Copy Folder — %s"
msgstr "Klasörü Kopyala — %s"

msgid "Copy folder %s to %s"
msgstr "%s klasörünü %s konumuna kopyala"

msgid "Copying file (%d of %d): %s…"
msgstr "Dosya kopyalanıyor (%d / %d): %s…"

msgid "Copying file: %s…"
msgstr "Dosya kopyalanıyor: %s…"

msgid "Copying folder: %s…"
msgstr "Klasör kopyalanıyor: %s…"

msgid "Creating copy at: %s…"
msgstr "Kopya oluşturuluyor: %s…"

msgid "Destination file path"
msgstr "Hedef dosya yolu"

msgid "Destination folder path"
msgstr "Hedef klasör yolu"

msgid "File copied successfully: %s -> %s"
msgstr "Dosya başarıyla kopyalandı: %s -> %s"

msgid "Folder copied successfully: %s -> %s (%d files)"
msgstr "Klasör başarıyla kopyalandı: %s -> %s (%d dosya)"

msgid "Hint: Enter a destination file path (e.g. 'addon/file.txt')."
msgstr "İpucu: Bir hedef dosya yolu girin (ör. 'addon/dosya.txt')."

msgid "Hint: Enter a destination folder path (e.g. 'addon/doc')."
msgstr "İpucu: Bir hedef klasör yolu girin (ör. 'addon/doc')."

msgid "Only files and folders can be copied."
msgstr "Yalnızca dosyalar ve klasörler kopyalanabilir."

msgid "Please enter a destination file path."
msgstr "Lütfen bir hedef dosya yolu girin."

msgid "Please enter a destination folder path."
msgstr "Lütfen bir hedef klasör yolu girin."

msgid "Please select a file or folder to copy."
msgstr "Lütfen kopyalanacak bir dosya veya klasör seçin."

msgid "The destination path is identical to the current path."
msgstr "Hedef yol geçerli yolla aynı."

msgid "Calculating SHA256: %s…"
msgstr "SHA256 hesaplanıyor: %s…"

msgid "Copy &SHA256 hash"
msgstr "&SHA256 değerini kopyala"

msgid "Could not calculate SHA256."
msgstr "SHA256 hesaplanamadı."

msgid "SHA256 hash copied to clipboard."
msgstr "SHA256 değeri panoya kopyalandı."
